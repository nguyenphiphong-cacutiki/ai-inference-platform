# =============================================================================
# Copy this file to ".env" and adjust as needed:  cp .env.example .env
# Docker Compose reads ".env" automatically for ${VAR} interpolation.
# =============================================================================

# ---- Models ----
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
COLLECTION_NAME=documents

# ---- Resource limits (tune to your machine) ----
OLLAMA_MEM_LIMIT=5g
OCR_MEM_LIMIT=2g
SEARCH_MEM_LIMIT=1g
MILVUS_MEM_LIMIT=3g

# ---- Grafana admin login ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- MinIO (Milvus object storage) credentials ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- Pinned image versions (override only if you know the tag exists) ----
OLLAMA_VERSION=latest
NGINX_VERSION=1.27-alpine
MILVUS_VERSION=v2.4.13
ETCD_VERSION=v3.5.5
MINIO_VERSION=RELEASE.2023-03-20T20-16-18Z
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.2.0
LOKI_VERSION=3.1.1
PROMTAIL_VERSION=3.1.1
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1
NGINX_EXPORTER_VERSION=1.3.0
